# DON — environment variables template
# Copy to .env and fill in values. Most are optional.
# Load with: set -a; source .env; set +a
# Or use python-dotenv: pip install python-dotenv

# ─── Ollama (required) ──────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434   # default

# ─── Push notifications ─────────────────────────────────────────────
# NTFY_URL=https://ntfy.sh             # or your self-hosted ntfy instance
# NTFY_TOPIC=don-alerts                # topic name (must match bridge.yaml)

# ─── Google OAuth (for Gmail/Calendar tools) ─────────────────────────
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback

# ─── GitHub (for git/PR tools) ───────────────────────────────────────
# GITHUB_TOKEN=ghp_...

# ─── Tailscale (production — A1 server) ──────────────────────────────
# The bridge binds to 127.0.0.1 by default (bridge.yaml: bind_host).
# On the A1, set bind_host to your tailscale IP and set:
# TAILSCALE_AUTHKEY=tskey-...

# ─── Home Assistant MCP ──────────────────────────────────────────────
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_access_token

# ─── Jellyfin MCP ───────────────────────────────────────────────────
# JELLYFIN_URL=http://jellyfin.local:8096
# JELLYFIN_API_KEY=your_api_key

# ─── Voice (optional, component-15) ─────────────────────────────────
# STT model is auto-downloaded by whisper.cpp; no key needed.
# Kokoro TTS model path (auto-downloaded by kokoro-onnx):
# KOKORO_MODEL_DIR=~/.local/share/don/kokoro

# ─── Debug / dev ─────────────────────────────────────────────────────
# DON_MODELS_YAML=config/models.override.yaml
# LOG_LEVEL=DEBUG
